# WhoWillSee 환경 변수 예시
# 보통은 실행 후 화면 상단 'AI 연결' 메뉴에서 설정하면 되고, 아래는 서버 운영자용입니다.
# 화면에서 저장한 설정(data/settings.json)이 있으면 그것이 우선합니다.

# --- Claude (Anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI 호환 API (OpenAI, Gemini, OpenRouter, Ollama, LM Studio 등) ---
# WHOWILLSEE_PROVIDER=openai_compatible
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.openai.com/v1
# WHOWILLSEE_MODEL=이미지-입력을-지원하는-모델-이름

# --- 음성 인식 (발표 녹음 분석용, 선택) ---
# WHOWILLSEE_STT_BASE_URL=https://api.openai.com/v1
# WHOWILLSEE_STT_MODEL=whisper-1
# WHOWILLSEE_STT_API_KEY=...

# --- 선택 ---
# WHOWILLSEE_EFFORT=medium            # Claude 분석 깊이: low | medium | high | xhigh | max
# WHOWILLSEE_PAGES_PER_CALL=6         # 한 번의 AI 호출에 넣는 페이지 수
# WHOWILLSEE_MAX_PAGES=40             # 변환할 최대 페이지 수
# WHOWILLSEE_DATA=./data              # 업로드·결과·설정 저장 폴더
# WHOWILLSEE_DEMO=1                   # 키가 있어도 데모 모드로 실행
# WHOWILLSEE_LOCK_SETTINGS=1          # 여러 사람이 쓰는 서버: 화면에서 AI 설정 변경 금지
# CHROMIUM_PATH=/path/to/chrome       # HTML 렌더링용 Chromium 경로 (보통 자동)
